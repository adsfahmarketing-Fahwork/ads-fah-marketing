# คัดลอกเป็น .env.local แล้วกรอกค่าจาก Supabase → Project Settings → API
# ใช้เฉพาะ anon (public) key เท่านั้น — ห้ามใส่ service_role key ในฝั่งเว็บเด็ดขาด
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ข้อมูลติดต่อบริษัทสำหรับหน้า "ประกาศความเป็นส่วนตัว" (/privacy) — ควรกรอกก่อนเปิดใช้งานจริง
VITE_PRIVACY_CONTACT_EMAIL=
VITE_COMPANY_PHONE=
VITE_COMPANY_ADDRESS=
